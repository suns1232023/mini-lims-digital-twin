
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/suns1232023/mini-lims-digital-twin/contracts/simulation.json",
  "title": "SimulationReport",
  "type": "object",
  "required": ["run_id", "scenario_id", "scenario_name", "started_at", "passed", "summary"],
  "properties": {
    "run_id":         { "type": "string" },
    "scenario_id":    { "type": "string", "enum": ["A","B","C","D","E","F","G","H","I"] },
    "scenario_name":  { "type": "string" },
    "seed":           { "type": "integer" },
    "started_at":     { "type": "string" },
    "completed_at":   { "type": ["string","null"] },
    "passed":         { "type": "boolean" },
    "summary": {
      "type": "object",
      "required": ["total_events","total_transitions","total_alarms","affected_samples"],
      "properties": {
        "total_events":      { "type": "integer", "minimum": 0 },
        "total_transitions": { "type": "integer", "minimum": 0 },
        "total_alarms":      { "type": "integer", "minimum": 0 },
        "affected_samples":  { "type": "integer", "minimum": 0 }
      }
    },
    "event_sequence":  { "type": "array" },
    "state_transitions":{ "type": "array" },
    "alarms":          { "type": "array" },
    "affected_samples":{ "type": "array", "items": { "type": "string" } },
    "workflow_impact": { "type": "array" },
    "recovery_path":   { "type": "array", "items": { "type": "string" } },
    "final_state":     { "type": "object" }
  }
}
