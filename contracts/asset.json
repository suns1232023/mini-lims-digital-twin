
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/suns1232023/mini-lims-digital-twin/contracts/asset.json",
  "title": "DigitalTwinAsset",
  "type": "object",
  "required": ["asset_id", "asset_type", "name", "status", "current_state"],
  "properties": {
    "asset_id":       { "type": "string", "minLength": 1 },
    "asset_type":     { "type": "string", "enum": ["incubator","autoclave","pass_box","environmental_sensor","biosafety_cabinet","workbench","refrigerator"] },
    "name":           { "type": "string" },
    "room_id":        { "type": ["string","null"] },
    "status":         { "type": "string", "minLength": 1 },
    "current_state":  { "type": "object" },
    "active_alarms":  { "type": "integer", "minimum": 0 },
    "active_samples": { "type": "integer", "minimum": 0 },
    "updated_at":     { "type": "string" },
    "last_telemetry_at": { "type": ["string","null"] }
  }
}
